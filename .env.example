# =============================================================================
# Infrastructure uniquement.
#
# Rien ici ne doit influencer un score d'evaluation : les parametres du
# pipeline (chunking, top_k, prompt, modeles) vivent dans configs/*.yml et
# entrent dans le hash de la config. Un parametre qui change un resultat
# sans apparaitre dans le hash rend deux runs faussement comparables.
# =============================================================================

# --- Postgres / pgvector -----------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ragbench

# --- Serveur d'inference (OpenAI-compatible) ---------------------------------
# Ollama central          : http://localhost:11434/v1  (hors Docker)
#                           http://ollama-central:11434/v1  (dans llm-net)
# vLLM (profil batch)     : http://vllm:8000/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama

# Appels LLM simultanes. A aligner sur OLLAMA_NUM_PARALLEL cote llm-service :
# demander plus ne fait que remplir la file d'attente du serveur.
LLM_CONCURRENCY=4
LLM_TIMEOUT_S=180
LLM_MAX_RETRIES=3
