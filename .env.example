# =============================================================================
# Infrastructure uniquement.
#
# Rien ici ne doit influencer un score d'evaluation : les parametres du
# pipeline (chunking, top_k, prompt, modeles) vivent dans configs/*.yml et
# entrent dans le hash de la config. Un parametre qui change un resultat
# sans apparaitre dans le hash rend deux runs faussement comparables.
# =============================================================================

# --- Postgres / pgvector -----------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ragbench

# --- Serveur d'inference (OpenAI-compatible) ---------------------------------
# Service LLM central (depot LLM-Service, proxy LiteLLM). Alias : chat,
# embed (bge-m3, 1024 dimensions), rerank, transcribe.
#   Depuis l'hote           : http://127.0.0.1:8080/v1
#   Depuis un conteneur     : http://llm-central:8080/v1  (reseau llm-net)
LLM_BASE_URL=http://127.0.0.1:8080/v1
# Cle obligatoire : valeur de LITELLM_MASTER_KEY dans le .env de LLM-Service.
# A copier dans .env (non suivi par git), jamais ici.
LLM_API_KEY=sk-local-...

# Appels LLM simultanes. Demander plus que ce que le service central absorbe
# ne fait que remplir sa file d'attente.
LLM_CONCURRENCY=4
LLM_TIMEOUT_S=180
LLM_MAX_RETRIES=3
